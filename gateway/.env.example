# Copy to gateway/.env (never commit it) or set these in your hosting provider.
# Which LLM classifies pages: claude or gemini. If unset, Gemini is used only when
# GEMINI_API_KEY is the one key set.
LLM_PROVIDER=claude

# Claude (console.anthropic.com). Fast, low-cost model suited to per-page checks.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Gemini (aistudio.google.com, free tier available). When a model is overloaded or
# retired, the comma-separated fallback models are tried in order.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
HOST=127.0.0.1
PORT=8787
# Requests per minute per client IP, and a hard daily cap across all clients (bounds spend).
RATE_LIMIT_PER_MINUTE=30
DAILY_REQUEST_CAP=5000
# Optional shared token the desktop app sends as "Authorization: Bearer <token>".
CLIENT_TOKEN=
# Folder with blocklist.json, allowlist.json, classification.json.
POLICY_DIR=../policy
