{
  "name": "studynest",
  "productName": "StudyNest",
  "private": true,
  "version": "0.4.0",
  "description": "StudyNest: a focus-first desktop browser for students.",
  "author": "StudyNest",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build && npm run gateway:build",
    "test:e2e": "npm run gateway:build && node e2e/run.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "gateway:build": "tsc -p gateway/tsconfig.json",
    "gateway:start": "node gateway/dist/gateway/src/main.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@types/node": "^22.10.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.48.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
